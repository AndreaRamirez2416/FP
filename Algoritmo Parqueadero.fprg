    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="PrecioHora, CantidadHoras, Total" type="Real" array="False" size=""/>
            <input variable="CantidadHoras"/>
            <input variable="PrecioHora"/>
            <assign variable="Total" expression="CantidadHoras*PrecioHora"/>
            <output expression="Total" newline="True"/>
        </body>
    </function>
