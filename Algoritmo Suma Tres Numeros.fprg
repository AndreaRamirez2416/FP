    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="N1, N2, N3, SUM" type="Real" array="False" size=""/>
            <input variable="N1"/>
            <input variable="N2"/>
            <input variable="N3"/>
            <assign variable="SUM" expression="N1+N2+N3"/>
            <output expression="SUM" newline="True"/>
        </body>
    </function>
