        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTE2OzA5OjM3OjE4IHAu4oCvbS47MTsxMTMwMQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="TiempoLlamada, ValorMinuto, Total" type="Real" array="False" size=""/>
            <input variable="TiempoLlamada"/>
            <input variable="ValorMinuto"/>
            <assign variable="Total" expression="TiempoLlamada*ValorMinuto"/>
            <output expression="Total" newline="True"/>
        </body>
    </function>
</flowgorithm>
