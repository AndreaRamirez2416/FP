<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Algoritmo Tarea Area Cuadrado Desigual"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-11 03:24:34 p.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTEwOzA3OjU2OjU0IGEu4oCvbS47MTExNzE="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTExOzAzOjI0OjM0IHAu4oCvbS47MzsxMTI4Ng=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="LadoB, LadoC, LadoA, AreaT" type="Integer" array="False" size=""/>
            <input variable="LadoB"/>
            <input variable="LadoC"/>
            <input variable="LadoA"/>
            <assign variable="AreaT" expression="(LadoB*LadoC)+LadoB*(LadoA-LadoC)/2"/>
            <output expression="AreaT" newline="True"/>
        </body>
    </function>
</flowgorithm>
