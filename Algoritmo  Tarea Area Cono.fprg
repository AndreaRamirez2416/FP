<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Algoritmo  Tarea Area Cono"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-11 03:34:58 p.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTExOzAzOjI0OjM4IHAu4oCvbS47MTExODA="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTExOzAzOjM0OjU4IHAu4oCvbS47MTsxMTI5MQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="AreaT, Radio, Base, Altura" type="Real" array="False" size=""/>
            <input variable="Radio"/>
            <input variable="Base"/>
            <input variable="Altura"/>
            <assign variable="AreaT" expression="(PI*Radio^2)/2+(Base-Altura)/2"/>
            <output expression="AreaT" newline="True"/>
        </body>
    </function>
</flowgorithm>
