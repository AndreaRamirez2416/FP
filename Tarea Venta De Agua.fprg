<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Tarea Venta De Agua"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-16 11:20:53 p.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTE2OzExOjExOjExIHAu4oCvbS47MTExNzE="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTE2OzExOjIwOjUzIHAu4oCvbS47MTsxMTI4NQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Volumen, Largo, Ancho, Alto, ValorM3, Total" type="Real" array="False" size=""/>
            <input variable="Largo"/>
            <input variable="Ancho"/>
            <input variable="Alto"/>
            <input variable="ValorM3"/>
            <assign variable="Volumen" expression="Alto*Ancho*Largo"/>
            <assign variable="Total" expression="Volumen*ValorM3"/>
            <output expression="Total" newline="True"/>
        </body>
    </function>
</flowgorithm>
