<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Metodo De Ordenamiento De Vectores (Quick Sort)"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-06-04 11:02:20 a.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA2LTA0OzA3OjU1OjIyIGEu4oCvbS47MTExNzA="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA2LTA0OzA3OjU4OjU0IGEu4oCvbS47MTthbmRyZTtIUENBUk9SQU1JUkVaOzIwMjYtMDYtMDQ7MDI6MDY6MjQgYS7igK9tLjtNZXRvZG8gRGUgT3JkZW5hbWllbnRvIERlIFZlY3RvcmVzIChTZWxlY3Rpb24gc29ydCkuZnByZzsyNzc1Nw=="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA2LTA0OzExOjAyOjIwIGEu4oCvbS47MTsxMTI2Mw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="V" type="Integer" array="True" size="7"/>
            <declare name="P, J, Pivote, Temp, Izq, Der" type="Integer" array="False" size=""/>
            <call expression="CrearVector(V)"/>
            <if expression="Izq&gt;=Der">
                <then>
                    <assign variable="return" expression="0"/>
                </then>
                <else/>
            </if>
            <assign variable="Pivote" expression="V[(Izq+Der)/2]"/>
            <assign variable="P" expression="Izq"/>
            <assign variable="J" expression="Der"/>
            <while expression="V&lt;=J">
                <while expression="V[P]&lt;Pivote">
                    <assign variable="V" expression="V+1"/>
                </while>
                <while expression="V[P]&gt;Pivote">
                    <assign variable="J" expression="J-1"/>
                </while>
                <if expression="V&lt;=J">
                    <then>
                        <assign variable="Temp" expression="V[P]"/>
                        <assign variable="V[P]" expression="V[J]"/>
                        <assign variable="V[J]" expression="Temp"/>
                        <assign variable="V" expression="V+1"/>
                        <assign variable="J" expression="J-1"/>
                    </then>
                    <else/>
                </if>
            </while>
        </body>
    </function>
    <function name="CrearVector" type="None" variable="">
        <parameters>
            <parameter name="Numeros" type="Integer" array="True"/>
        </parameters>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="6" direction="inc" step="1">
                <input variable="Numeros[i]"/>
            </for>
        </body>
    </function>
</flowgorithm>
