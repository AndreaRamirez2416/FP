    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="LONG, X1, X2, Y1, Y2" type="Real" array="False" size=""/>
            <input variable="X1"/>
            <input variable="X2"/>
            <input variable="Y1"/>
            <input variable="Y2"/>
            <assign variable="LONG" expression="SQRT(((X2-X1)^2)+((Y2-Y1)^2))"/>
            <output expression="LONG" newline="True"/>
        </body>
    </function>
