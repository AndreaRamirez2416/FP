<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Algoritmo Se&#241;ora Arepas"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-03-28 12:07:24 a.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTAzLTI3OzA5OjM4OjQ5IHAu4oCvbS47MTExOTk="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTAzLTI4OzEyOjA3OjI0IGEu4oCvbS47MjsxMTI3Nw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="TipoA" type="String" array="False" size=""/>
            <declare name="Precio" type="Integer" array="False" size=""/>
            <declare name="Cantidad" type="Integer" array="False" size=""/>
            <declare name="Total" type="Integer" array="False" size=""/>
            <input variable="TipoA"/>
            <input variable="Cantidad"/>
            <if expression="TipoA=&quot;S&quot;">
                <then>
                    <assign variable="Total" expression="Cantidad*1000"/>
                </then>
                <else>
                    <if expression="TipoA=&quot;D&quot;">
                        <then>
                            <assign variable="Total" expression="Cantidad*2000"/>
                        </then>
                        <else>
                            <assign variable="Total" expression="cantidad*10000"/>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="Total" newline="True"/>
        </body>
    </function>
</flowgorithm>
