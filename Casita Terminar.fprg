<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Casita Terminar"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-30 09:26:30 p.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTMwOzA5OjA2OjMyIHAu4oCvbS47MTExODE="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTMwOzA5OjI2OjMwIHAu4oCvbS47MTsxMTI4OQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, Cantidad" type="Integer" array="False" size=""/>
            <input variable="Cantidad"/>
            <for variable="i" start="1" end="Cantidad" direction="inc" step="1">
                <call expression="HacerCasitas"/>
            </for>
        </body>
    </function>
    <function name="HacerCasitas" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Alto, Ancho, Tama&#241;o" type="Integer" array="False" size=""/>
            <assign variable="Tama&#241;o" expression="random(100)"/>
            <assign variable="Ancho" expression="Tama&#241;o*10"/>
            <assign variable="Alto" expression="Tama&#241;o*10"/>
            <call expression="HacerRectangulo(Ancho,Alto)"/>
            <turn expression="" rotate="right"/>
            <call expression="HacerTriangulo(Ancho)"/>
            <call expression="HacerRectangulo((Ancho/4),(Alto/4))"/>
        </body>
    </function>
    <function name="HacerRectangulo" type="None" variable="">
        <parameters>
            <parameter name="Ancho" type="Real" array="False"/>
            <parameter name="Alto" type="Real" array="False"/>
        </parameters>
        <body>
            <forward expression="Alto" pen="down"/>
            <turn expression="90" rotate="right"/>
            <forward expression="Ancho" pen="down"/>
            <turn expression="90" rotate="right"/>
            <forward expression="Alto" pen="down"/>
            <turn expression="90" rotate="right"/>
            <forward expression="Ancho" pen="down"/>
        </body>
    </function>
    <function name="HacerTriangulo" type="None" variable="">
        <parameters>
            <parameter name="Ancho" type="Real" array="False"/>
        </parameters>
        <body/>
    </function>
</flowgorithm>
