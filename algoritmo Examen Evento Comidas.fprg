<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="algoritmo Examen Evento Comidas"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-23 08:51:50 p.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTIzOzA4OjQ2OjMxIHAu4oCvbS47MTExODU="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTIzOzA4OjUxOjUwIHAu4oCvbS47MTsxMTI5MA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Cantidad, ValorTotal" type="Integer" array="False" size=""/>
            <input variable="Cantidad"/>
            <if expression="Cantidad&gt;200">
                <then>
                    <if expression="Cantidad&lt;300">
                        <then>
                            <assign variable="ValorTotal" expression="Cantidad*15000"/>
                        </then>
                        <else>
                            <assign variable="ValorTotal" expression="Cantidad*10000"/>
                        </else>
                    </if>
                </then>
                <else>
                    <assign variable="ValorTotal" expression="Cantidad*20000"/>
                </else>
            </if>
            <output expression="ValorTotal" newline="True"/>
        </body>
    </function>
</flowgorithm>
