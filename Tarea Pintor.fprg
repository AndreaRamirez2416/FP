    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Area, Largo, Ancho, Total, ValorM2" type="Real" array="False" size=""/>
            <input variable="Largo"/>
            <input variable="Ancho"/>
            <input variable="ValorM2"/>
            <assign variable="Area" expression="Largo*Ancho"/>
            <assign variable="Total" expression="Area*ValorM2"/>
            <output expression="Total" newline="True"/>
        </body>
    </function>
