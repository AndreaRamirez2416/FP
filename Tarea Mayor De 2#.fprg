<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Tarea Mayor De 2#"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-16 11:33:17 p.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTE2OzExOjI2OjI0IHAu4oCvbS47MTExODE="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTE2OzExOjMzOjE3IHAu4oCvbS47MTsxMTI4OQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Numero1, Numero2, Mayor" type="Real" array="False" size=""/>
            <input variable="Numero1"/>
            <input variable="Numero2"/>
            <if expression="Numero1&gt;Numero2">
                <then>
                    <assign variable="Mayor" expression="Numero1"/>
                </then>
                <else>
                    <assign variable="Mayor" expression="Numero2"/>
                </else>
            </if>
            <output expression="Mayor" newline="True"/>
        </body>
    </function>
</flowgorithm>
