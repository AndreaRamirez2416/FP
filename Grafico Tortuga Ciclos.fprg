<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Grafico Tortuga Ciclos"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-30 07:30:59 p.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTMwOzA3OjEzOjM2IHAu4oCvbS47MTExODE="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTMwOzA3OjMwOjU5IHAu4oCvbS47MTsxMTI5Mw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, Cantidad, j" type="Integer" array="False" size=""/>
            <input variable="Cantidad"/>
            <for variable="j" start="1" end="Cantidad" direction="inc" step="1">
                <for variable="i" start="1" end="Cantidad" direction="inc" step="1">
                    <forward expression="100" pen="down"/>
                    <turn expression="360/Cantidad" rotate="right"/>
                </for>
                <turn expression="360/Cantidad" rotate="right"/>
            </for>
        </body>
    </function>
</flowgorithm>
