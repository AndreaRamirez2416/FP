<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Algoritmo Pesos a Dolares"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-16 07:46:45 p.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTE2OzA3OjE5OjU4IHAu4oCvbS47MTExOTU="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTE2OzA3OjQ2OjQ1IHAu4oCvbS47MTsxMTI5OQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="TotalP, TDolar, TC" type="Real" array="False" size=""/>
            <input variable="TDolar"/>
            <input variable="TC"/>
            <assign variable="TotalP" expression="TDolar*TC"/>
            <output expression="TotalP" newline="True"/>
        </body>
    </function>
</flowgorithm>
