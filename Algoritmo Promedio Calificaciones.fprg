<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Algoritmo Promedio Calificaciones"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-03-27 10:55:43 p.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTAzLTI3OzEwOjUwOjQ1IHAu4oCvbS47MTExODE="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTAzLTI3OzEwOjU1OjQzIHAu4oCvbS47MTsxMTI5Mg=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="N1, N2, N3, N4, PROM" type="Real" array="False" size=""/>
            <input variable="N1"/>
            <input variable="N2"/>
            <input variable="N3"/>
            <input variable="N4"/>
            <assign variable="PROM" expression="(N1+N2+N3+N4)/4"/>
            <output expression="PROM" newline="True"/>
        </body>
    </function>
</flowgorithm>
