<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Promedio Ciclo Para"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-21 09:47:22 p.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA1LTE0OzA2OjMzOjE0IHAu4oCvbS47MTExODE="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA1LTIxOzA5OjQ3OjIyIHAu4oCvbS47MjsxMTI5NQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, Edad, Promedio, CantidadAlumnos, Suma, CantidadSalones, j" type="Integer" array="False" size=""/>
            <input variable="CantidadSalones"/>
            <assign variable="Suma" expression="0"/>
            <for variable="j" start="1" end="CantidadSalones" direction="inc" step="1">
                <input variable="CantidadAlumnos"/>
                <for variable="i" start="1" end="CantidadAlumnos" direction="inc" step="1">
                    <comment text="Pido la edad"/>
                    <input variable="Edad"/>
                    <assign variable="Suma" expression="Suma+Edad"/>
                </for>
            </for>
            <assign variable="Promedio" expression="Suma/CantidadAlumnos"/>
            <output expression="Promedio" newline="True"/>
        </body>
    </function>
</flowgorithm>
