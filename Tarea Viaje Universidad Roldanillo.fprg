<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Tarea Viaje Universidad Roldanillo"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-28 10:49:49 p.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTI4OzEwOjM2OjEzIHAu4oCvbS47MTExODI="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTI4OzEwOjQ5OjQ5IHAu4oCvbS47MTsxMTMwMw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="CantidadEstudiantes, Total" type="Real" array="False" size=""/>
            <input variable="CantidadEstudiantes"/>
            <if expression="CantidadEstudiantes&gt;100">
                <then>
                    <assign variable="Total" expression="CantidadEstudiantes*65000"/>
                </then>
                <else>
                    <if expression="CantidadEstudiantes&gt;50">
                        <then>
                            <assign variable="Total" expression="CantidadEstudiantes*70000"/>
                        </then>
                        <else>
                            <if expression="CantidadEstudiantes&gt;30">
                                <then>
                                    <assign variable="Total" expression="CantidadEstudiantes*95000"/>
                                </then>
                                <else>
                                    <assign variable="Total" expression="8000000"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="Total" newline="True"/>
        </body>
    </function>
</flowgorithm>
