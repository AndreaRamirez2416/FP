<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Algoritmo Hospedaje Hotel"/>
        <attribute name="authors" value="andre"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-09 07:29:54 p.&#8239;m."/>
        <attribute name="created" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTA5OzA3OjA1OjMzIHAu4oCvbS47MTExODU="/>
        <attribute name="edited" value="YW5kcmU7SFBDQVJPUkFNSVJFWjsyMDI2LTA0LTA5OzA3OjI5OjU0IHAu4oCvbS47MTsxMTMwMg=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="TipoH" type="String" array="False" size=""/>
            <declare name="ValorT, DiasH" type="Integer" array="False" size=""/>
            <input variable="TipoH"/>
            <input variable="DiasH"/>
            <if expression="TipoH=&quot;A&quot;">
                <then>
                    <assign variable="ValorT" expression="DiasH*70000"/>
                </then>
                <else>
                    <if expression="TipoH=&quot;V&quot;">
                        <then>
                            <assign variable="ValorT" expression="DiasH*60000"/>
                        </then>
                        <else>
                            <assign variable="ValorT" expression="DiasH*100000"/>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="ValorT" newline="True"/>
        </body>
    </function>
</flowgorithm>
